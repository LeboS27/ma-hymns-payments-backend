# Copy to .env (or set these as your host's environment variables) and fill
# in real values. Never commit .env or paste these values into chat/tickets —
# PAYNOW_INTEGRATION_KEY signs every request, anyone with it can charge your
# merchant account.

# From your Paynow merchant dashboard (paynow.co.zw) — the same account used
# by the Mfundo project, or a new one you register for this church/app.
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# The public URL of THIS server's routes, once deployed — Paynow calls
# resulturl as its own webhook, and returnurl is where the user could be
# redirected in a web flow (unused in the app-only USSD-push flow below, but
# Paynow's API requires both fields to be present and non-empty).
PAYMENTS_RESULT_URL=https://your-deployed-host/api/payments/result
PAYMENTS_RETURN_URL=https://your-deployed-host/api/payments/result

# Shown to Paynow as the "authemail" field on the transaction — doesn't need
# to be a real inbox, just a stable identifier for your merchant account.
DONATION_AUTH_EMAIL=donations@example.org

PORT=3000
